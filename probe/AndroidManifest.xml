<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.projectorsoft.probe"
    android:versionCode="2"
    android:versionName="2.0">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:label="ProjectorProbe"
        android:debuggable="true"
        android:hasCode="true">

        <receiver
            android:name=".ProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.projectorsoft.probe.CMD" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TrdProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.projectorsoft.probe.TRD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
